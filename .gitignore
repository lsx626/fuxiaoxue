# Android
android-app/.gradle/
android-app/.gradle-home/
android-app/build/
android-app/app/build/
android-app/local.properties
android-app/release.keystore
android-app/.idea/
*.apk
*.aab

# 本机构建/探查用的临时 jar（POI 依赖缓存等）
.tmp-jars/

# 本地数据 / 密钥
*.cookie.json
cookies.json
sync_state.db
# SQLite WAL 侧车文件：任何脚本/测试打开过库就会生成，禁止入库
sync_state.db-wal
sync_state.db-shm
*=ro
config.yaml
elearning_files/
.DS_Store
Thumbs.db

# 发布物（二进制，通过 GitHub Release 分发）
release/

*.spec
# Keep the release recipe versioned; other local/spec scratch files remain
# ignored by the rule above.
!elearning-sync/复小学.spec

# Android UI 测试截图
android-app/screenshots/

# GitHub Release 令牌（本地敏感，绝不提交）
.gh-token
